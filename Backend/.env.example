# RPC endpoint used for deployments. Any Sepolia RPC works; Infura/Alchemy are more reliable than public ones.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the wallet that deploys the contracts. It needs a little Sepolia ETH for gas.
# Never commit this file and never put this key anywhere in the frontend.
DEPLOYER_PRIVATE_KEY=

# Optional: enables `npx hardhat verify` on Sepolia Etherscan.
ETHERSCAN_API_KEY=
