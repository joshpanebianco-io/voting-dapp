# All values are optional. Without a .env file the app targets the public Sepolia
# deployment listed in src/config.js through a public RPC endpoint.

# Chain the contracts are deployed on (11155111 = Sepolia, 31337 = local Hardhat node)
VITE_CHAIN_ID=11155111

# Read-only RPC endpoint. A dedicated Infura/Alchemy URL is more reliable than public RPCs.
VITE_RPC_PROVIDER_URL=https://ethereum-sepolia-rpc.publicnode.com

# Contract addresses (printed by `npm run deploy:sepolia` in ../Backend)
VITE_POLLMANAGER_CONTRACT_ADDRESS=0xEFCCF9B71bBa10562899b3Ad858bad6e2F83B86f
VITE_POLLRETRIEVER_CONTRACT_ADDRESS=0xeD3031Bf2d6d88dEa275F4E4d1b807c7872273c1

# Optional: URL of the faucet service in ../Backend/faucet. Leave empty to show public faucet links only.
VITE_FAUCET_URL=

# Path the app is served from. "/voting-dapp/" for GitHub Pages, "/" for a root domain.
VITE_BASE_PATH=/voting-dapp/
